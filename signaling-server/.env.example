# Bind host and port for @karosync/signaling
HOST=0.0.0.0
PORT=8080

# Maximum connected mic clients allowed per room
MAX_CLIENTS_PER_ROOM=8

# WebSocket ping/pong heartbeat interval in milliseconds
HEARTBEAT_INTERVAL_MS=30000

# Optional comma-separated Origin allowlist for production hardening.
# Leave empty to allow all origins (recommended during local dev and Chrome Extension testing).
# Example: ALLOWED_ORIGINS=https://mic.example.com,chrome-extension://*
ALLOWED_ORIGINS=
