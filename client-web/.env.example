# Production WebSocket URL of @karosync/signaling (required for Vercel / Cloudflare Pages / self-hosted builds)
VITE_SIGNALING_URL=wss://signaling.example.com

# Optional (local development only): target signaling server for Vite's /ws and /health proxy
# VITE_DEV_SIGNALING_TARGET=http://127.0.0.1:8080
